# LLM Wiki Template — .gitignore

# ── Python virtual env & secrets ──────────────────────────────────────────────
.venv/
venv/
ENV/
.env
.env.local
.env.*
__pycache__/
*.pyc
*.pyo

# ── Session exports — local only, never commit raw transcripts ────────────────
sessions/exports/*
sessions/confidential/*
sessions/wiki-digests/*
!sessions/exports/.gitkeep
!sessions/confidential/.gitkeep
!sessions/wiki-digests/.gitkeep
!raw/.gitkeep

# ── SQLite index — regenerable from exports ───────────────────────────────────
sessions.db
sessions.db-shm
sessions.db-wal

# ── Confidentiality sentinel — transient ──────────────────────────────────────
.claude/no-export
.claude/hooks.log

# ── OS and editor noise ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
*.swp
*.swo
.idea/
.vscode/